{
  "name": "wirebot-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "Wirebot on the Claude Agent SDK — a Telegram, Slack, and Discord bridge to a Claude agent.",
  "license": "MIT",
  "homepage": "https://github.com/nocell/wirebot-agent#readme",
  "bugs": {
    "url": "https://github.com/nocell/wirebot-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocell/wirebot-agent.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun scripts/build-assets.ts && tailwindcss -i ./src/miniapp/styles.css -o ./dist/miniapp/public/app.css --minify",
    "check": "tsc -p tsconfig.json && biome check .",
    "dev": "bun run build && bun --watch src/cli/main.ts start",
    "start": "bun src/cli/main.ts start"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@emoji-mart/data": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "grammy": "^1.45.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "undici-real": "npm:undici@^7.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/cli": "^4.1.11",
    "@types/node": "^24.13.3",
    "@types/node-fetch": "2.6.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "tailwindcss": "^4.1.11",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@slack/socket-mode@3.0.0": "patches/@slack%2Fsocket-mode@3.0.0.patch"
  }
}
