# Copy to .env and fill in. At least one connector and one Claude credential are required.

# ---------------------------------------------------------------------------
# Claude credential: set exactly one way for the agent (Claude Code) to reach Claude.
#
# Claude Console API key, billed per token. Use this (or a cloud provider) for any
# instance that more than one person can talk to.
# ANTHROPIC_API_KEY=
#
# Amazon Bedrock or Google Cloud instead of the Anthropic API, plus the provider's usual
# credential and region variables (see the Claude Code docs).
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# CLAUDE_CODE_USE_VERTEX=1
#
# Personal Claude subscription (Pro/Max): a token from `claude setup-token`. Anthropic's terms
# allow this only for your own use, on a single-user instance that only you talk to. Never use
# a personal subscription to serve other people.
# CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Telegram connector. Create the bot with @BotFather.
# TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated Telegram numeric user IDs. Messages from everyone else are
# ignored, including guest-mode mentions. Set together with the bot token.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Slack connector (Socket Mode). Set all three together to enable it;
# see docs/slack.md for the full setup guide, including a pasteable app manifest.
# SLACK_BOT_TOKEN=xoxb-replace-me
# SLACK_APP_TOKEN=xapp-replace-me
# SLACK_ALLOWED_USER_IDS=U0123ABCDEF
# Optional: restrict instance-wide Slack commands to these members.
# SLACK_ADMIN_USER_IDS=U0123ABCDEF

# Text-only Discord connector. Set the bot token and comma-separated
# user snowflakes together; see docs/discord.md for setup and permissions.
# DISCORD_BOT_TOKEN=replace-me
# DISCORD_ALLOWED_USER_IDS=123456789012345678
# Optional: restrict instance-wide Discord commands to these users.
# DISCORD_ADMIN_USER_IDS=123456789012345678

# ---------------------------------------------------------------------------
# Public HTTPS origin serving the web app and Telegram Mini App, normally through a reverse proxy.
# Leave it unset to expose the web app through a TryCloudflare quick tunnel instead (needs
# cloudflared on the PATH; the Docker image ships it). Set WIREBOT_TUNNEL=off to disable that.
#PUBLIC_URL=https://wirebot.example.com
WIREBOT_TUNNEL=auto

# Optional runtime paths and listener settings.
WIREBOT_DATA_DIR=.wirebot
WIREBOT_WORKSPACE=.wirebot/workspace
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Use a separately installed `claude` binary instead of the one bundled with the Agent SDK.
# WIREBOT_CLAUDE_EXECUTABLE=/usr/local/bin/claude

# Optional: let the agent read Slack history (threads, pasted links, channel history) through the
# bundled slack-history skill. Use the bot token itself or, better, a separate read-only Slack
# app's token. Wirebot hands it to the agent as a private file. See docs/slack.md.
# WIREBOT_SLACK_READ_TOKEN=xoxb-replace-me
